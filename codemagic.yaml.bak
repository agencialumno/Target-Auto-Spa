workflows:
  ios-testflight:
    name: Target Auto Spa iOS
    instance_type: mac_mini_m2
    max_build_duration: 60
    integrations:
      app_store_connect: Codemagic Target Auto Spa
    environment:
      xcode: latest
      node: 20
      vars:
        BUNDLE_ID: "br.com.lumno.targetautospa"
      ios_signing:
        provisioning_profiles:
          - target-app-store
        certificates:
          - target-distribution
    scripts:
      - name: Instalar Rust e alvos do iPhone
        script: |
          if ! command -v rustup >/dev/null 2>&1; then
            curl https://sh.rustup.rs -sSf | sh -s -- -y
          fi
          echo "PATH=$HOME/.cargo/bin:$PATH" >> $CM_ENV
          export PATH="$HOME/.cargo/bin:$PATH"
          rustup target add aarch64-apple-ios
      - name: Instalar dependencias do projeto
        script: |
          npm install
      - name: Definir numero do build
        script: |
          node -e "const fs=require('fs');const p='src-tauri/tauri.conf.json';const c=JSON.parse(fs.readFileSync(p,'utf8'));c.bundle=c.bundle||{};c.bundle.iOS=c.bundle.iOS||{};c.bundle.iOS.bundleVersion=String(process.env.BUILD_NUMBER||1);fs.writeFileSync(p,JSON.stringify(c,null,2));"
      - name: Gerar o projeto iOS
        script: |
          brew install xcodegen || true
          npm run tauri ios init -- --ci
      - name: Configurar assinatura no projeto Xcode
        script: |
          cd src-tauri/gen/apple
          ls
          xcode-project use-profiles
      - name: Construir o app iOS
        script: |
          export PATH="$HOME/.cargo/bin:$PATH"
          unset IOS_CERTIFICATE IOS_CERTIFICATE_PASSWORD IOS_MOBILE_PROVISION

          # O Tauri compila e cria o archive. A exportacao dele pode falhar, entao seguimos mesmo assim
          npm run tauri ios build -- --export-method app-store-connect || true

          ARCHIVE="$(find src-tauri/gen/apple -name '*.xcarchive' | head -1)"
          echo "Archive encontrado: $ARCHIVE"
          if [ -z "$ARCHIVE" ]; then
            echo "Nenhum archive foi gerado"
            exit 1
          fi

          cat > /tmp/ExportOptions.plist <<'EOF'
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>method</key>
            <string>app-store-connect</string>
            <key>teamID</key>
            <string>KH97Q8M556</string>
            <key>signingStyle</key>
            <string>manual</string>
            <key>signingCertificate</key>
            <string>Apple Distribution</string>
            <key>provisioningProfiles</key>
            <dict>
              <key>br.com.lumno.targetautospa</key>
              <string>Target Auto Spa App Store</string>
            </dict>
            <key>uploadSymbols</key>
            <false/>
          </dict>
          </plist>
          EOF

          xcodebuild -exportArchive \
            -archivePath "$ARCHIVE" \
            -exportPath src-tauri/gen/apple/build/export \
            -exportOptionsPlist /tmp/ExportOptions.plist

          ls src-tauri/gen/apple/build/export
    artifacts:
      - src-tauri/gen/apple/build/**/*.ipa
    publishing:
      app_store_connect:
        auth: integration
        submit_to_testflight: true